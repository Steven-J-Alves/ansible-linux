# Managed by Ansible — baseline_audit role.
log_file = /var/log/audit/audit.log
log_format = RAW
flush = INCREMENTAL_ASYNC
freq = 50
max_log_file = {{ baseline_audit_max_log_file }}
num_logs = {{ baseline_audit_num_logs }}
max_log_file_action = {{ baseline_audit_max_log_file_action }}
space_left = 75
space_left_action = SYSLOG
admin_space_left = 50
admin_space_left_action = SUSPEND
disk_full_action = SUSPEND
disk_error_action = SUSPEND
